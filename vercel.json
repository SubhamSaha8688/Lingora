{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/users/:match*",
      "destination": "/api/users"
    },
    {
      "source": "/api/users",
      "destination": "/api/users"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/progress/:match*",
      "destination": "/api/progress"
    },
    {
      "source": "/api/tutor",
      "destination": "/api/tutor"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/curriculum/:match*",
      "destination": "/api/curriculum"
    },
    {
      "source": "/api/curriculum",
      "destination": "/api/curriculum"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
