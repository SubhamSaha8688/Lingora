{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, learning statistics, and account settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "targetLanguage": { "type": "string", "maxLength": 20 },
        "currentLevel": { "type": "string", "maxLength": 20 },
        "totalXp": { "type": "number" },
        "streak": { "type": "number" },
        "hearts": { "type": "number" },
        "gems": { "type": "number" },
        "dailyGoalXp": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "plan": { "type": "string", "enum": ["free", "premium"] },
        "interfaceLanguage": { "type": "string", "enum": ["english", "hindi"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "displayName", "targetLanguage", "currentLevel", "totalXp", "streak"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Individual lesson progress records for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "lessonId": { "type": "string", "maxLength": 128 },
        "languageId": { "type": "string", "maxLength": 20 },
        "level": { "type": "string", "maxLength": 20 },
        "completed": { "type": "boolean" },
        "score": { "type": "number" },
        "xpEarned": { "type": "number" },
        "completedAt": { "type": "string" }
      },
      "required": ["userId", "lessonId", "languageId", "completed", "score", "xpEarned"]
    },
    "Language": {
      "title": "Language",
      "description": "Language curriculum configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 10 },
        "flag": { "type": "string", "maxLength": 10 },
        "description": { "type": "string", "maxLength": 500 },
        "nativeName": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "code", "flag"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Curriculum lesson with vocabulary, grammar notes and interactive exercises",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "languageId": { "type": "string", "maxLength": 20 },
        "level": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "languageId", "level", "title", "description", "order"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Course-wise paid/licensed study guide, cheatsheet or booklet",
      "type": "object",
      "properties": {
        "materialId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "languageId": { "type": "string", "maxLength": 20 },
        "level": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 500 },
        "priceInInr": { "type": "number" },
        "pagesCount": { "type": "number" },
        "previewUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["materialId", "title", "languageId", "level", "priceInInr"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "User purchased study materials record",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "materialId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["completed", "pending", "refunded"] },
        "purchasedAt": { "type": "string" }
      },
      "required": ["purchaseId", "userId", "materialId", "amount", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator designation",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "grantedAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and gamification stats"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "UserProgress",
      "description": "Lesson completion tracking per user"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Study material purchase receipts"
    },
    "/languages/{langId}": {
      "schema": "Language",
      "description": "Configured courses and languages"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Curriculum lessons with exercises"
    },
    "/materials/{materialId}": {
      "schema": "StudyMaterial",
      "description": "Study guides, grammar reference handbooks and PDF material"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "System administrator registry"
    }
  }
}
