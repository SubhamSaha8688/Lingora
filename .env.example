# =================================================================
# Lingora Environment Configuration
# =================================================================

# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Google Gemini API Key (Required for AI Language Tutor & Quiz Generator)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Administrator Emails (Comma-separated)
# Accounts with these emails will automatically receive admin privileges in the UI
VITE_ADMIN_EMAILS=shadowmonarch8688@gmail.com

# Hosted Application URL (for webhooks, production CORS, or OAuth callbacks)
APP_URL=http://localhost:3000
