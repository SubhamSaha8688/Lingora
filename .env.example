# =================================================================
# Lingora Environment Configuration
# =================================================================

# 1. MongoDB Atlas URI (Free tier supported at https://cloud.mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/lingora?retryWrites=true&w=majority
MONGODB_URI=

# 2. JWT Secret for secure user login and token generation
JWT_SECRET=lingora-secure-jwt-secret-key-2026

# 3. Google Gemini API Key (Required for AI Language Tutor & Quiz Generator)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 5. Administrator Emails (Comma-separated)
# Accounts with these emails will automatically receive admin privileges in the UI
VITE_ADMIN_EMAILS=shadowmonarch8688@gmail.com

# 6. Server Port & Environment
PORT=3000
NODE_ENV=development
