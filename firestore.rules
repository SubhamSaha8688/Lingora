rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishwanathpatil1922@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().userId == userId &&
          (incoming().role == existing().role || (existing().role == null && incoming().role == 'user'))
        )
      );
      allow delete: if isAdmin();

      // Subcollection: User lesson progress
      match /progress/{progressId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().userId == userId)
        );
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Subcollection: Purchased study materials
      match /purchases/{purchaseId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().userId == userId)
        );
        allow delete: if isAdmin();
      }
    }

    // Languages curriculum definition
    match /languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lessons and exercises
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Paid & Licensed Study Materials
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Admins
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
